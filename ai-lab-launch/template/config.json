  "panels": [
   {
    "t": 1.2,
    "title": "scene 1: the name",
    "reads": [
     "\"This is Stoker\" types, 0.5 to 1.6 s",
     "the coin-art collage drifts outward, 0.4 to 3.6 s"
    ]
   },
   {
    "t": 2.9,
    "title": "scene 1: the category",
    "reads": [
     "\"A launchpad on Solana\" replaces the name, 1.9 to 3.4 s",
     "the last cards leave the frame as the cut comes, 3.0 to 3.7 s"
    ]
   },
   {
    "t": 4.3,
    "title": "scene 2: made for creators",
    "reads": [
     "\"made for creators\" types in white over full-bleed flashes, 3.6 to 4.4 s",
     "one flash per 16th note with a click, 3.6 to 5.0 s; the riser climbs into the drop"
    ]
   },
   {
    "t": 6.3,
    "title": "scene 3: the drop",
    "reads": [
     "the drop lands at 5.0 s; \"$STOKER\" types in the launch bar, 5.0 to 5.7 s",
     "\"Launch against ANY asset\", 5.0 to 6.3 s, ANY in the gradient with a soft landing at 5.8 s",
     "the card arrives, 5.4 to 5.8 s, then its quote asset switches on every 16th, 5.9 to 7.0 s, over the fixed chip \"paired with TSLAx or any other famous xStock\""
    ]
   },
   {
    "t": 8.2,
    "title": "scene 4: the pairing",
    "reads": [
     "\"Pair it with a stock\", 7.0 to 7.8 s",
     "eight Quote Asset tiles fly into the grid on \"stock\", 7.6 to 8.3 s"
    ]
   },
   {
    "t": 9.4,
    "title": "scene 4: it just trades",
    "reads": [
     "\"and it just... trades\", 8.3 to 9.4 s",
     "the grid opens into a ring, 8.3 to 9.0 s",
     "a price chart climbs inside the card, 8.9 to 9.6 s"
    ]
   },
   {
    "t": 12.2,
    "title": "scene 5: the MORE line",
    "reads": [
     "\"The more they trade\", 9.9 to 10.6 s",
     "\"the MORE you earn\", 11.1 to 11.9 s, MORE in the gradient at 11.3 s",
     "the glass pill counts \"You earn 0.50% of every trade\", 11.9 to 12.5 s"
    ]
   },
   {
    "t": 14.0,
    "title": "scene 6: the settings",
    "reads": [
     "the panel rises in, 12.5 to 12.9 s",
     "Reward tax moves on \"reward\", 13.0 to 13.7 s; Payout flips to \"in SOL\" on \"payout\", 14.3 to 15.0 s; First buy on \"first\", 15.3 to 16.0 s",
     "the fire behind the glass rolls on 16ths from 14.3 s and turns poster at 15.3 s"
    ]
   },
